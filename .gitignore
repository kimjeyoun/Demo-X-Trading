# .gitignore (프로젝트 최상위 폴더)

# =========================
# Dependencies & Build Artifacts
# =========================
# Node.js 패키지 폴더
node_modules/
/backend/node_modules/
/frontend/node_modules/

# 빌드 결과물
/dist/
/backend/dist/
/frontend/dist/

# 로그 파일 및 임시 파일
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# =========================
# Environment Variables
# =========================
# 민감한 환경 변수 파일 (절대 올리면 안 됨!)
.env
.env.*
!.env.example

# =========================
# Docker
# =========================
# 도커 데이터 볼륨 (이것이 mysql.sock 문제를 해결)
/data/

# =========================
# IDE & OS specific
# =========================
# VSCode 설정
.vscode/

# macOS
.DS_Store

# Windows
Thumbs.db